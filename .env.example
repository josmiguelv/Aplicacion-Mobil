# Pollos B3 Android — única URL base del Administrador Web.
# Copia este archivo como .env y edita B3_API_BASE para tus compilaciones locales.
# Solo URLs HTTPS; no agregues /api/v1 ni barras finales obligatorias.
B3_API_BASE=https://back-neutral-rogers-switched.trycloudflare.com

# OAuth Web client ID de Firebase/Google Cloud (no es un secreto).
# Dejar vacío conserva el build y desactiva Google Login hasta completar Firebase.
B3_GOOGLE_WEB_CLIENT_ID=
